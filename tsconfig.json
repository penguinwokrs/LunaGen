{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "compilerOptions": {
    "paths": {
      "~*": [
        "./*"
      ]
    },
    "baseUrl": ".",
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  }
}
