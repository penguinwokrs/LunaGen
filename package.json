{
  "name": "lunagen",
  "displayName": "LunaGen",
  "version": "1.16.0",
  "description": "AI-powered message generator for Luna",
  "author": "PenguinWokrs <dev.and.penguin@gmail.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "HEADED=1 playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:harness": "PAUSE=1 HEADED=1 playwright test generate-button.spec.ts -g 手動 --headed",
    "e2e:login": "playwright codegen --channel=chromium --user-data-dir=e2e/.profile https://luna-matching.com/",
    "e2e:codegen": "playwright codegen --channel=chromium https://luna-matching.com/"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@plasmohq/storage": "^1.15.0",
    "ai": "^6.0.116",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@vitejs/plugin-react": "^5.1.2",
    "crx3": "^2.0.0",
    "jsdom": "^27.4.0",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^4.0.17"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "storage",
      "downloads",
      "tabs",
      "scripting"
    ]
  }
}
